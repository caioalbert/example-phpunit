{
	"name": "caioalbert/example-phpunit",
	"description": "Example PHPUnit project with SonarQube coverage integration",

	"require-dev": {
		"ext-curl": "*",
		"ext-dom": "*",
		"ext-json": "*",
		"ext-sqlite3": "*",
		"phpunit/phpunit": "^9.6"
	},
	"autoload": {
		"psr-4": {
			"App\\": "src"
		}
	},
	"autoload-dev": {
		"psr-4": {
			"App\\Test\\": "test"
		}
	},
	"config": {
		"platform": {
			"php": "8.3.0"
		},
		"sort-packages": true
	},
	"scripts": {
		"test": "phpunit --configuration test/phpunit.xml",
		"test:coverage": [
			"@php -r \"is_dir('build/logs') || mkdir('build/logs', 0777, true);\"",
			"phpunit --configuration test/phpunit.xml --coverage-clover build/logs/clover.xml --log-junit build/logs/junit.xml"
		]
	}
}
